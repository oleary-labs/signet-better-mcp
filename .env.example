# ---- Better Auth (runs in-process) ----------------------------------------
# Secret for signing cookies/tokens. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# SQLite database path. For Railway with persistent disk, use /data/auth.db
# DATABASE_URL=file:./data/auth.db

# ---- Social providers -----------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Signet ---------------------------------------------------------------
# Group contract address (0x...). Lowercased. Alpha (Ethereum mainnet):
SIGNET_GROUP_ID=0x641b8f6c932be48084d6d28fbb0be18a2410d753

# Bootstrap node URLs in the group. Comma-separated. Use the TLS endpoints.
SIGNET_NODE_URLS=https://oll1.nodes.oleary.com,https://oll2.nodes.oleary.com,https://oll3.nodes.oleary.com

# ---- ZK prover / bundler --------------------------------------------------
SIGNET_PROVER_URL=http://signet-min-bundler.railway.internal:4337/v1/prove
SIGNET_BUNDLER_API_KEY=

# ---- Chain RPC (JSON map of chainId -> URL) --------------------------------
# Base and Arc (5042, defaults to https://rpc.mainnet.arc.io) work unset.
# SIGNET_RPC_URLS={"8453":"https://mainnet.base.org","5042":"https://rpc.mainnet.arc.io"}

# ---- This service ---------------------------------------------------------
# On Railway, PORT must equal the custom domain's target port.
PORT=4100
# Also the JWT issuer: must match the addIssuer entry on the group exactly.
PUBLIC_URL=https://signet-mcp.oleary.com
